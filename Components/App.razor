<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TaskManager.styles.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <HeadOutlet />
    <script>
        // Aplica o tema antes do Blazor carregar, evitando flash de tema errado
        (function () {
            var saved = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = saved || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        // ── TEMA ──────────────────────────────────────────────────────────────
        window.themeManager = {
            _isDark: function () {
                var saved = localStorage.getItem('theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                return saved === 'dark' || (!saved && prefersDark);
            },
            applyToRoot: function () {
                var isDark = this._isDark();
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
                return isDark;
            },
            toggle: function () {
                var next = !this._isDark();
                localStorage.setItem('theme', next ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', next ? 'dark' : 'light');
                return next;
            },
            isDark: function () {
                return this._isDark();
            }
        };

        document.addEventListener('blazor:navigated', function () {
            window.themeManager.applyToRoot();
        });

        // ── RECONEXÃO CUSTOMIZADA ────────────────────────────────────────────
        // Overlay amigável durante quedas de conexão do circuito Blazor Server,
        // com retry automático antes de exigir reload manual.
        function showReconnectOverlay() {
            document.getElementById('reconnect-overlay')?.classList.add('show');
        }
        function hideReconnectOverlay() {
            document.getElementById('reconnect-overlay')?.classList.remove('show');
        }

        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 8,
                    retryIntervalMilliseconds: 3000
                },
                reconnectionHandler: {
                    onConnectionDown: showReconnectOverlay,
                    onConnectionUp: hideReconnectOverlay
                }
            }
        });
    </script>

    <div id="reconnect-overlay" class="reconnect-overlay">
        <div class="reconnect-box">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="mb-2">Reconectando...</p>
            <button class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                Recarregar página
            </button>
        </div>
    </div>

    <style>
        .reconnect-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .reconnect-overlay.show {
            display: flex;
        }
        .reconnect-box {
            background: var(--bg-card, white);
            color: var(--text-body, #212529);
            padding: 32px 40px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
    </style>
</body>
</html>
