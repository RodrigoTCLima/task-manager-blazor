@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Cadastro confirmado";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-header">
        <i class="bi bi-envelope-check auth-logo"></i>
        <h1 class="auth-title">Cadastro realizado!</h1>
        <p class="auth-subtitle">
            Sua conta foi criada com o email <strong>@Model.Email</strong>.
        </p>
    </div>

    <div class="alert alert-warning small mb-4">
        <i class="bi bi-info-circle me-1"></i>
        Nosso sistema de envio automático de emails ainda está em configuração.
        Para ativar sua conta, entre em contato com o desenvolvedor informando o email cadastrado.
    </div>

    <div class="auth-links">
        <a href="/Identity/Account/Login">← Voltar ao login</a>
    </div>
</div>